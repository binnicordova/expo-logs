{
  "name": "expo-logs",
  "version": "0.1.0",
  "description": "File logger for Expo apps (iOS, Android, Web) written in pure TypeScript. Works in Expo Go and ships over expo-updates: no native code. Log rotation, console capture, share and email logs.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "sideEffects": false,
  "files": [
    "build",
    "src",
    "!src/**/__tests__",
    "!**/*.tsbuildinfo",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/",
    "test": "node internal/module_scripts/test.js",
    "prepare": "node internal/module_scripts/prepare.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run clean && CI=1 bun run test && bun run lint && bun run prepare"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-go",
    "expo-updates",
    "logger",
    "logging",
    "file-logger",
    "logs",
    "log-rotation",
    "console",
    "typescript",
    "ios",
    "android",
    "web",
    "react-native-file-logger"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/binnicordova/expo-logs.git"
  },
  "bugs": {
    "url": "https://github.com/binnicordova/expo-logs/issues"
  },
  "author": "BinniCordova <binni.2000.cordova@gmail.com> (https://github.com/binnicordova)",
  "license": "MIT",
  "homepage": "https://github.com/binnicordova/expo-logs#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "^29.2.1",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.5",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "expo": "58.0.0-preview.8",
    "expo-file-system": "~58.0.3",
    "expo-mail-composer": "~58.0.0",
    "expo-sharing": "~58.0.11",
    "jest": "^29.7.0",
    "jest-expo": "~58.0.4",
    "prettier": "^3.0.0",
    "react": "19.3.0",
    "react-native": "0.88.0-rc.2",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "expo": ">=58.0.0-0",
    "expo-file-system": ">=58.0.0",
    "expo-mail-composer": "*",
    "expo-sharing": "*",
    "react": "*",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "expo-mail-composer": {
      "optional": true
    },
    "expo-sharing": {
      "optional": true
    }
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ]
  }
}
